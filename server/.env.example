PORT=5000
NODE_ENV=production
# Production: use a TLS MongoDB URI, a dedicated least-privilege DB user, and restricted network access.
MONGO_URI=mongodb://localhost:27017/quizgen
# Set exact frontend HTTPS origin(s), comma-separated. Use http://localhost:5173 only for local development.
CLIENT_URL=https://your-frontend.example.com
# Generate a private random value of at least 32 characters. Do not commit the real value.
JWT_SECRET=
