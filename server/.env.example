PORT=5000
NODE_ENV=production
# Local example only; use your hosted MongoDB connection string on Render.
MONGO_URI=mongodb://localhost:27017/quizgen
# Exact Netlify site origin; separate additional origins with commas.
CLIENT_URL=https://your-site-name.netlify.app
# Generate a private random value of at least 32 characters. Do not commit it.
JWT_SECRET=
# Render terminates TLS at its edge proxy; keep this at 1 for the Render Web Service.
TRUST_PROXY_HOPS=1
